{
  "name": "vox-desktop",
  "version": "1.0.3",
  "description": "VOX Desktop - Voice and Text Chat",
  "author": "VOX Team",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "web": "npm run dev --prefix frontend",
    "dev:web": "npm run dev --prefix frontend",
    "dev:desktop": "electron .",
    "dev:all": "concurrently \"npm run dev --prefix frontend\" \"electron .\"",
    "backend": "node backend/server.js",
    "setup:backend": "cd backend && npm install",
    "setup:nodejs": "node -e \"console.log('Portable Node.js is bundled automatically during electron-builder build')\"",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:win",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --win --mac --linux",
    "build:local": "electron-builder --win",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish=always",
    "release:win": "cd dist2 && electron-builder --win --publish always --config.publish.provider=github",
    "release:dry": "cd dist2 && electron-builder --win --publish never --config.publish.provider=github",
    "bump": "node scripts/bump-version.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zuhair321/vox.git"
  },
  "build": {
    "appId": "com.vox.desktop",
    "productName": "VOX",
    "icon": "build-resources/icon-256.png",
    "asar": true,
    "asarUnpack": [
      "frontend/dist/**/*",
      "frontend/dist/**/*.node",
      "backend/**/*.node"
    ],
    "directories": {
      "output": "./dist",
      "buildResources": "build-resources"
    },
    "publish": {
      "provider": "github",
      "owner": "zuhair321",
      "repo": "vox",
      "releaseType": "release"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/nodejs",
        "to": "nodejs"
      },
      {
        "from": "tools/postgres",
        "to": "postgres",
        "filter": [
          "pgsql/bin/**/*",
          "pgsql/lib/**/*",
          "pgsql/share/**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/*.log",
          "!uploads/**/*",
          "!vox.db",
          "!prisma/vox.db",
          "!**/*.map",
          "!node_modules/.cache/**",
          "!node_modules/@opentelemetry/**",
          "!node_modules/@prisma/instrumentation/**",
          "!node_modules/vite/**",
          "!node_modules/vitest/**",
          "!node_modules/@vitest/**",
          "!node_modules/@esbuild/**",
          "!node_modules/@rollup/**",
          "!node_modules/rollup/**",
          "!node_modules/tsx/**",
          "!node_modules/pm2/**",
          "!node_modules/@pm2/**",
          "!node_modules/@types/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VOX",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build-resources/icon-256.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-resources/icon-256.png"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "ws": "^8.21.1",
    "electron-updater": "^6.1.7"
  }
}
