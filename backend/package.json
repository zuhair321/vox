{
  "name": "vox-backend",
  "version": "0.2.0",
  "description": "VOX backend — Express + Prisma (SQLite) + JWT + 2FA + Socket.io",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "cluster": "pm2 start ../ecosystem.config.cjs",
    "cluster:restart": "pm2 restart vox-backend",
    "cluster:stop": "pm2 stop vox-backend",
    "cluster:logs": "pm2 logs vox-backend",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node seed.mjs",
    "prisma:studio": "prisma studio",
    "verify:routes": "node scripts/verify-routes.mjs",
    "db:setup": "prisma migrate dev --name init && prisma db seed",
    "check": "node --check server.js && node -e \"const{execSync}=require('child_process');require('fs').readdirSync('src').filter(f=>f.endsWith('.js')).forEach(f=>execSync('node --check src/'+f))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "node seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "redis": "^4.6.12",
    "resend": "^6.16.0",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.5",
    "pm2": "^7.0.3",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6"
  }
}
