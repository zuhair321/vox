// Prisma Schema for VOX Backend — PostgreSQL (single source of truth)
//
// Provider is "postgresql" and the migration history (prisma/migrations/*) is
// Postgres-only (migration_lock.toml = "postgresql"). This is the canonical
// database for both local dev (Docker Postgres) and production (Supabase /
// Railway / Neon). There is NO SQLite mode anymore — keeping two DB engines in
// sync was the source of the old ambiguity, so it was removed.
//
// Dev (one command):  docker compose up -d   ->  Postgres on :5432
// Migrate:            npx prisma migrate deploy
// Quick start (no history): npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String    @unique
  displayName      String
  passwordHash     String
  role             String    @default("MEMBER")
  color            String    @default("#5865f2")
  status           String    @default("OFFLINE")
  activity         String?
  /// X25519 public key (base64, 32 bytes) for E2E DM envelope.
  /// Paired with a per-user private key the renderer keeps and the
  /// main process never reads. See frontend/src/utils/dmCrypto.ts.
  publicKey        String?
  publicKeyFingerprint String? /// SHA-256 of the public key, used for trust UI.
  /// When this row was last bumped the device's pubkey (used to invalidate stale ciphertexts).
  keyRotatedAt     DateTime?
  isBot            Boolean       @default(false)
  botTokenHash     String?
  botPrefix        String?
  botDescription   String?
  botPublicKey     String?
  botCreatedAt     DateTime  @default(now())

  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  avatarUrl        String?
  bannerUrl        String?
  bio              String?
  emailVerified    Boolean   @default(false)
  loginAttempts    Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  hasTurbo         Boolean   @default(true)
  turboSince       DateTime? @default(now())

  ownedServers    Server[]
  serverMembers   ServerMember[]
  channelMessages Message[]       @relation("MessageAuthor")
  dmsSent         DmMessage[]     @relation("dmMessagesSent")
  dmsReceived     DmMessage[]     @relation("dmMessagesReceived")
  ownedGroupDms    GroupDm[]
  groupDmMemberships GroupDmMember[]
  groupDmsSent     GroupDmMessage[] @relation("GroupDmMessagesSent")
  friends         Friend[]        @relation("friend_requests_sent")
  friendsOf       Friend[]        @relation("friend_requests_received")
  invitesCreated  Invite[]
  serverBans      ServerBan[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordReset[]
  reactions       Reaction[]
  blocks          Block[]         @relation("BlockUser")
  blockedBy       Block[]         @relation("BlockedUser")
  reports         Report[]        @relation("ReportReporter")
  reportedBy      Report[]        @relation("ReportedUser")
  userNotes       UserNote[]      @relation("UserNoteAuthor")
  notesAbout      UserNote[]      @relation("UserNoteTarget")
  templates       ServerTemplate[]
  apiKeys         ApiKey[]
  pinnerPins      PinNotification[] @relation("PinPinner")
  pinTargets      PinNotification[] @relation("PinTarget")
  loginHistory    LoginHistory[]
  badges          UserBadge[]
  pushSubscriptions PushSubscription[]
  reminders       Reminder[]
  activityData    Json?
  profileTheme    String? // theme id, e.g. "midnight", "sunset"
  avatarFrame     String? // emoji or image url frame around avatar
  animatedAvatar  Boolean  @default(false)
  voiceSettings   Json?   // { quality, region, noiseSuppression, echoCancellation, autoGain }
  notificationSettings NotificationSettings[]
  integrations      Integration[]
  moderationLogs    ModerationLog[] @relation("ModerationLogModerator")
  appealReviews     Appeal[] @relation("AppealReviewer")
  appealMessages    AppealMessage[]
  messageReads      MessageRead[]
  dmPreferences    DmPreference[]
}

// ─── Server ──────────────────────────────────────────────────────

model Server {
  id               String   @id @default(uuid())
  name             String
  description      String?
  icon             String?
  banner           String?
  category         String   @default("COMMUNITY")
  isPublic         Boolean  @default(false)
  verificationLevel String  @default("NONE")
  vanityUrl        String?
  defaultChannelId String?
  require2FA       Boolean   @default(false)
  region           String?
  featured         Boolean   @default(false)
  featuredOrder    Int       @default(0)
  boosts           Int       @default(0) // raw boost count
  boosters         Json?     // array of userIds who boosted (dedup)
  rulesScreening   Boolean   @default(false)
  welcomeMessage   String?
  welcomeChannels  Json?
  subcategory      String?
  createdAt        DateTime @default(now())
  ownerId          String
  updatedAt        DateTime @default(now())

  owner      User           @relation(fields: [ownerId], references: [id])
  channels   Channel[]
  members    ServerMember[]
  invites    Invite[]
  serverBans ServerBan[]
  auditLogs  AuditLog[]
  categories Category[]
  webhooks   Webhook[]
  emojis     CustomEmoji[]
  templates  ServerTemplate[]
  widgets    ServerWidget[]
  stats      ServerStats[]
  badges     Badge[]
  sounds     Sound[]
  automodConfig AutomodConfig?
  moderationConfig ModerationConfig?
  strikes    Strike[]

  @@index([ownerId])
}

// ─── AutomodConfig (per-server auto-moderation settings) ──

model AutomodConfig {
  id            String   @id @default(uuid())
  serverId      String   @unique
  filterWords   Boolean  @default(true)
  filterLinks   Boolean  @default(true)
  filterSpam    Boolean  @default(true)
  maxStrikes    Int      @default(3)
  strikeTimeout Int      @default(1440) // minutes to timeout after maxStrikes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ─── Strike (auto-mod / moderator strikes against a member) ──

model Strike {
  id        String    @id @default(uuid())
  serverId  String
  userId    String
  issuedBy  String
  reason    String
  auto      Boolean   @default(false)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, userId])
}

// ── ServerWidget (embeddable server widget config) ──

model ServerWidget {
  id         String   @id @default(uuid())
  serverId   String   @unique
  enabled    Boolean  @default(false)
  theme      String   @default("dark")
  showOnline Boolean  @default(true)
  showJoin   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ─── Channel ─────────────────────────────────────────────────────

model Channel {
  id         String   @id @default(uuid())
  name       String
  topic      String   @default("")
  type       String   @default("TEXT")
  position   Int      @default(0)
  nsfw       Boolean  @default(false)
  slowmode   Int      @default(0)
  region     String   @default("auto")
  rtcMode    String   @default("MESH") // MESH (peer-to-peer) | SFU (media server)
  maxParticipants Int  @default(0) // 0 = mode default (MESH=6, SFU=unlimited)
  stageEnabled Boolean @default(false)
  createdAt  DateTime @default(now())
  categoryId String?
  serverId   String?
  updatedAt  DateTime @default(now())

  server      Server?      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id])
  messages    Message[]
  permissions Permission[]
  channelPermissions ChannelPermission[]
  webhooks    Webhook[]
  archiveConfig ChannelArchiveConfig?
  pinNotifications PinNotification[]
  stageSpeakers StageSpeaker[]
  announcementFollows AnnouncementFollow[]

  @@index([serverId])
  @@index([categoryId])
  @@index([serverId, createdAt])
}

// ─── DmMessage ───────────────────────────────────────────────────

// ─── Message ─────────────────────────────────────────────────────

model Message {
  id             String   @id @default(uuid())
  channelId      String
  userId         String?
  authorOverride String?
  body           String
  createdAt      DateTime @default(now())
  attachments    Json?
  deleted        Boolean  @default(false)
  edited         Boolean  @default(false)
  editHistory    Json?
  parentId       String?
  pinned         Boolean  @default(false)
  isForumPost    Boolean  @default(false)
  tags           Json?
  searchVector   Unsupported("tsvector")?

  channel        Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author         User?      @relation("MessageAuthor", fields: [userId], references: [id])
  parentMessage  Message?   @relation("MessageThread", fields: [parentId], references: [id])
  threadMessages Message[]  @relation("MessageThread")
  reactions      Reaction[]
  pinNotifications PinNotification[]

  @@index([channelId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@index([channelId, deleted, createdAt])
}

model DmMessage {
  id          String   @id @default(uuid())
  /// Plaintext kept ONLY for the legacy / migration window. E2E rows have this NULL.
  content     String?
  /// Base64 X25519 + ChaCha20-Poly1305 envelope. The server NEVER holds the key.
  ciphertext  String?
  /// Base64 12-byte nonce paired with `ciphertext`.
  nonce       String?
  /// Bumped when the sender rotates their keypair. The receiver uses this to
  /// select which stored peer public key to use for decryption.
  keyVersion  Int      @default(1)
  /// SHA-256 fingerprint of the sender's public key at encryption time —
  /// the UI shows this as a verifiable lock badge and warns on mismatch.
  senderKeyFingerprint String?
  attachments Json?
  dmId        String
  senderId    String
  recipientId String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  edited      Boolean  @default(false)
  deleted     Boolean  @default(false)

  sender    User @relation("dmMessagesSent", fields: [senderId], references: [id])
  recipient User @relation("dmMessagesReceived", fields: [recipientId], references: [id])

  @@index([dmId, createdAt])
  @@index([recipientId, read])
  @@index([senderId, createdAt])
  @@index([dmId, keyVersion])
}

// ─── Friend ──────────────────────────────────────────────────────

model Friend {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user   User @relation("friend_requests_sent", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("friend_requests_received", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId, status])
  @@index([friendId, status])
}

// ─── ServerMember ────────────────────────────────────────────────

model ServerMember {
  id          String   @id @default(uuid())
  serverId    String
  userId      String
  role        String   @default("MEMBER")
  nick        String?
  joinedAt    DateTime @default(now())
  mutedUntil  DateTime?
  deafened    Boolean  @default(false)
  timeoutUntil DateTime?
  
  customPowers Json?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
}

// ─── Invite ──────────────────────────────────────────────────────

model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  serverId  String
  creatorId String
  maxUses   Int       @default(0)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([creatorId])
}

// ─── ServerBan ───────────────────────────────────────────────────

model ServerBan {
  id        String    @id @default(uuid())
  serverId  String
  userId    String
  reason    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([serverId, userId])
  @@index([serverId])
}

// ─── AuditLog ────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  serverId  String
  userId    String
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([serverId, createdAt])
}

// ─── Category ────────────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  serverId  String
  createdAt DateTime @default(now())

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]
}

// ─── Permission ──────────────────────────────────────────────────

model Permission {
  id        String  @id @default(uuid())
  channelId String
  role      String
  canRead   Boolean @default(true)
  canWrite  Boolean @default(true)
  canManage Boolean @default(false)
  canAdmin  Boolean @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, role])
}

// ─── Reaction ────────────────────────────────────────────────────

model Reaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

// ─── RefreshToken ────────────────────────────────────────────────

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  revoked    Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  deviceInfo String?
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── LoginHistory ────────────────────────────────────────────────

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  deviceInfo String?
  ipAddress  String?
  userAgent  String?
  location   String?
  alertSent  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── PasswordReset ───────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  type      String   @default("RESET")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Block ───────────────────────────────────────────────────────

model Block {
  id        String   @id @default(uuid())
  userId    String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  user    User @relation("BlockUser", fields: [userId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedId])
}

// ─── Webhook ─────────────────────────────────────────────────────

model Webhook {
  id        String   @id @default(uuid())
  serverId  String
  channelId String
  name      String
  avatarUrl String?
  url       String?
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server  Server  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([channelId])
}

// ─── CustomEmoji ─────────────────────────────────────────────────

model CustomEmoji {
  id        String   @id @default(uuid())
  serverId  String
  name      String
  url       String
  animated  Boolean  @default(false)
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@index([serverId])
}

// ─── Report ──────────────────────────────────────────────────────

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String?
  messageId      String?
  serverId       String?
  type           String
  reason         String
  details        String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  reporter     User? @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id])

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([serverId])
  @@index([status])
  @@index([messageId])
}

// ─── ServerRole (raw table managed manually) ─────────────────────

model ServerRole {
  id          String   @id @default(uuid())
  serverId    String
  name        String
  color       String   @default("#5865f2")
  hoist       Boolean  @default(false)
  mentionable Boolean  @default(false)
  position    Int      @default(0)
  permissions String   @default("0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serverId, name])
  @@index([serverId])
}

// ─── ServerMemberRole (raw table managed manually) ──────────────

model ServerMemberRole {
  id             String   @id @default(uuid())
  serverMemberId String
  roleId         String
  createdAt      DateTime @default(now())

  @@index([serverMemberId])
  @@index([roleId])
}

// ─── MessageRead (raw table managed manually) ────────────────────

model MessageRead {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([userId])
  @@index([messageId, readAt])
  @@unique([messageId, userId])
}

// ─── UserNote (private notes about other users) ────────────────

model UserNote {
  id        String   @id @default(uuid())
  userId    String
  targetId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation("UserNoteAuthor", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("UserNoteTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
}

// ─── ServerTemplate ────────────────────────────────────────────

model ServerTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  serverId    String
  data        Json
  uses        Int      @default(0)
  createdAt   DateTime @default(now())

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

// ─── ApiKey (personal API tokens for integrations) ─────────────

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  name      String
  keyHash   String   @unique
  keyPrefix String
  scopes    String   @default("*")
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── PinNotification ───────────────────────────────────────────

model PinNotification {
  id        String   @id @default(uuid())
  channelId String
  messageId String
  pinnedBy  String
  userId    String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinner  User    @relation("PinPinner", fields: [pinnedBy], references: [id], onDelete: Cascade)
  user    User    @relation("PinTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ─── ChannelArchiveConfig ──────────────────────────────────────

model ChannelArchiveConfig {
  id             String   @id @default(uuid())
  channelId      String   @unique
  enabled        Boolean  @default(false)
  daysToKeep     Int      @default(90)
  lastArchivedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

// ─── ServerStats (real-time analytics) ─────────────────────────

model ServerStats {
  id             String   @id @default(uuid())
  serverId       String
  date           DateTime @default(now())
  messageCount   Int      @default(0)
  activeUsers    Int      @default(0)
  voiceMinutes   Int      @default(0)
  peakConcurrent Int      @default(0)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, date])
  @@index([serverId, date])
}

// ─── Badge (profile badges: Hypesquad, Nitro, Bug Hunter, custom, server) ──

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String   // emoji or image url
  type        String   @default("CUSTOM") // HYPESQUAD | NITRO | BUG_HUNTER | STAFF | EARLY | SERVER | CUSTOM
  color       String?  @default("#5865f2")
  serverId    String?
  createdAt   DateTime @default(now())

  server Server?    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  users  UserBadge[]

  @@index([serverId])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  assignedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// ─── Sound (soundboard: server sounds + global sounds) ──

model Sound {
  id        String   @id @default(uuid())
  name      String
  url       String
  serverId  String?  // null = global sound
  volume    Float    @default(1.0)
  createdAt DateTime @default(now())

  server Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@index([serverId])
}

// ─── StageSpeaker (stage channel speakers/requests) ──

model StageSpeaker {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  status    String   @default("REQUESTED") // REQUESTED | SPEAKER | MOD
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

// ─── PushSubscription (Web Push / VAPID device subscriptions) ──

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Reminder (user-set reminders, delivered via socket) ──

model Reminder {
  id        String   @id @default(uuid())
  userId    String
  channelId String?
  message   String
  remindAt  DateTime
  recurring String?  // null | 'DAILY' | 'WEEKLY' | 'MONTHLY'
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

// ─── AnnouncementFollow (crosspost announcements to follower servers) ──

model AnnouncementFollow {
  id                String   @id @default(uuid())
  channelId         String   // the announcement channel being followed
  followerServerId  String   // server that follows it
  createdAt         DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, followerServerId])
  @@index([followerServerId])
}

// ─── Integration (connected external services: Slack, Spotify, Calendar, etc.) ──

model Integration {
  id         String   @id @default(uuid())
  userId     String
  serverId   String?
  type       String   // SLACK | SPOTIFY | CALENDAR | DISCORD | MATRIX
  name       String
  config     Json?    // webhook url, tokens (env-gated, encrypted at rest by caller)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serverId])
}

// ─── NotificationSettings (per-user mute of servers/channels) ──

model NotificationSettings {
  id         String   @id @default(uuid())
  userId     String
  serverId   String?
  channelId  String?
  /// ALL | MENTIONS | NOTHING | DEFAULT (inherit from server).
  level      String   @default("DEFAULT")
  muted      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A row is either a server-level mute or a channel-level mute.
  @@unique([userId, serverId, channelId])
  @@index([userId])
}

// ─── AppConfig (singleton KV — VAPID keys live here once first push lands)
model AppConfig {
  id           String   @id @default("singleton")
  vapidPublic  String?
  vapidPrivate String?
  vapidSubject String?
  updatedAt    DateTime @updatedAt
}

model Feedback {
  id         String   @id @default(uuid())
  category   String   @default("general")
  message    String
  rating     Int?
  userAgent  String?
  page       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([rating])
}

// ─── ChannelPermission (allow/deny bitfield overrides) ──────────

model ChannelPermission {
  id        String  @id @default(uuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  roleId    String?
  userId    String?

  allow     BigInt  @default(0)
  deny      BigInt  @default(0)

  @@unique([channelId, roleId])
  @@unique([channelId, userId])
}

// ─── Moderation Enums ──────────────────────────────────────────

enum ModerationActionType {
  KICK
  BAN
  TEMPBAN
  UNBAN
  TIMEOUT
  UNTIMEOUT
  MUTE
  UNMUTE
  DEAFEN
  UNDEAFEN
  WARN
  DELETE_MESSAGE
  BULK_DELETE
  NICKNAME_CHANGE
  ROLE_ASSIGN
  ROLE_REMOVE
  CHANNEL_LOCK
  CHANNEL_UNLOCK
  SLOWMODE_SET
  VERIFICATION_SET
}

enum AppealStatus {
  NONE
  PENDING
  APPROVED
  DENIED
}

enum AppealStage {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_RESPONSE
  APPROVED
  DENIED
  ESCALATED
}

enum AutoModTriggerType {
  SPAM
  MENTION_SPAM
  KEYWORD
  REGEX
  INVITE_LINK
  LINK
  CAPS
  EMOJI_SPAM
  ATTACHMENT_SPAM
  NEWLINE_SPAM
  ZALGO_TEXT
  CUSTOM_ML
}

enum AutoModActionType {
  BLOCK_MESSAGE
  SEND_ALERT
  TIMEOUT_USER
  KICK_USER
  BAN_USER
  WARN_USER
  ADD_ROLE
  REMOVE_ROLE
  SEND_DM
  QUARANTINE
  LOG_ONLY
}

// ─── ModerationLog ────────────────────────────────────────────

model ModerationLog {
  id          String   @id @default(uuid())
  serverId    String
  action      ModerationActionType
  targetId    String
  targetType  String   @default("user")

  moderatorId String
  moderator   User     @relation("ModerationLogModerator", fields: [moderatorId], references: [id])

  reason      String?
  duration    Int?
  evidence    Json?

  appealed    Boolean  @default(false)
  appealReason String?
  appealStatus AppealStatus @default(NONE)

  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  appeals    Appeal[]

  @@index([serverId, targetId])
  @@index([serverId, createdAt])
}

// ─── AutoModRule ──────────────────────────────────────────────

model AutoModRule {
  id          String   @id @default(uuid())
  serverId    String
  name        String
  enabled     Boolean  @default(true)

  triggerType AutoModTriggerType
  triggerConfig Json

  actions     AutoModAction[]

  exemptRoles       Json
  exemptChannels    Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── AutoModAction ────────────────────────────────────────────

model AutoModAction {
  id          String   @id @default(uuid())
  ruleId      String
  rule        AutoModRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  type        AutoModActionType
  config      Json?
  order       Int      @default(0)
}

// ─── Appeal ───────────────────────────────────────────────────

model Appeal {
  id              String   @id @default(uuid())
  moderationLogId String
  log             ModerationLog @relation(fields: [moderationLogId], references: [id])

  reason        String
  evidence      Json?

  stage         AppealStage @default(SUBMITTED)
  reviewerId    String?
  reviewer      User?     @relation("AppealReviewer", fields: [reviewerId], references: [id])
  reviewNotes   String?
  reviewedAt    DateTime?

  messages      AppealMessage[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── AppealMessage ────────────────────────────────────────────

model AppealMessage {
  id        String   @id @default(uuid())
  appealId  String
  appeal    Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

// ─── CustomPower ──────────────────────────────────────────────

model CustomPower {
  id          String   @id @default(uuid())
  serverId    String
  name        String
  description String?
  icon        String?

  grants      Json
  grantableBy Json     // String[]
  maxHolders  Int?

  createdAt   DateTime @default(now())
}

// ─── ModerationWebhook ────────────────────────────────────────

model ModerationWebhook {
  id          String   @id @default(uuid())
  serverId    String
  url         String
  secret      String
  events      Json     // String[]
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
}

// ─── ModerationConfig (per-server escalation + quarantine settings) ──

model ModerationConfig {
  id              String   @id @default(uuid())
  serverId        String   @unique
  escalationRules  Json    // Array of { warningThreshold, action, duration }
  quarantineEnabled Boolean @default(true)
  quarantineAction  String  @default("DELETE_MESSAGE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ─── DmPreference (per-user DM conversation settings) ──────────

model DmPreference {
  id              String   @id @default(uuid())
  userId          String
  dmId            String
  muted           Boolean  @default(false)
  mutedUntil      DateTime?
  showAvatar      Boolean  @default(true)
  showDisplayName Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dmId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
// Group DMs — Multi-person direct messages (up to 10 members)
// ═══════════════════════════════════════════════════════════════
model GroupDm {
  id          String   @id @default(uuid())
  name        String?  // Optional group name
  icon        String?  // Optional group icon
  ownerId     String   // Creator of the group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupDmMember[]
  messages    GroupDmMessage[]
  
  @@index([ownerId])
}

model GroupDmMember {
  id          String   @id @default(uuid())
  groupDmId   String
  userId      String
  nickname    String?  // Optional nickname in this group
  joinedAt    DateTime @default(now())
  lastReadAt  DateTime?
  
  // Relations
  groupDm     GroupDm  @relation(fields: [groupDmId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([groupDmId, userId])
  @@index([groupDmId])
  @@index([userId])
}

model GroupDmMessage {
  id          String   @id @default(uuid())
  content     String?
  ciphertext  String?  // E2E encrypted content
  nonce       String?
  keyVersion  Int      @default(1)
  senderKeyFingerprint String?
  attachments Json?
  groupDmId   String
  senderId    String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  edited      Boolean  @default(false)
  deleted     Boolean  @default(false)
  
  // Relations
  groupDm     GroupDm  @relation(fields: [groupDmId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  @@index([groupDmId, createdAt])
  @@index([senderId])
}

// ═══════════════════════════════════════════════════════════════
// Stickers — Custom sticker packs for messages
// ═══════════════════════════════════════════════════════════════
model Sticker {
  id          String   @id @default(uuid())
  name        String   // Display name
  tags        String   // Related emoji (for search)
  assetUrl    String   // Image URL
  type        String   @default("png") // png, gif, apng
  available   Boolean  @default(true)
  serverId    String?  // null = global sticker
  creatorId   String
  createdAt   DateTime @default(now())
  usageCount  Int      @default(0)
  
  // Relations
  server      Server?  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  @@index([serverId])
  @@index([creatorId])
  @@index([tags])
}

model StickerPack {
  id          String   @id @default(uuid())
  name        String
  description String?
  creatorId   String
  stickers    Sticker[]
  createdAt   DateTime @default(now())
  
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  @@index([creatorId])
}
