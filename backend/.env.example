# VOX Backend Environment Configuration
# Copy to `.env` and fill in real values.

# ── Database ────────────────────────────────────────────────────────────────
# PRODUCTION: PostgreSQL (recommended). The Prisma schema provider is
# "postgresql" (backend/prisma/schema.prisma). Example connection strings:
#   Local:     postgresql://vox:YOUR_PASSWORD@127.0.0.1:5432/vox_dev
#   Railway:   (auto-injected by the PostgreSQL add-on — leave DATABASE_URL unset)
#   Supabase:  postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres
#   Neon:      postgresql://user:pass@ep-xxx.neon.tech/vox?sslmode=require
# Apply the schema with:  npx prisma migrate deploy   (or `prisma db push`)
#
# Dev (one command):  docker compose up -d   ->  Postgres on :5432
#
# POOLER SPLIT (important for Supabase/Neon free tiers):
#   - DATABASE_URL       = the POOLED connection (transaction mode, port 6543).
#                           The running app uses this so it never exhausts Postgres
#                           connections. This is what Railway/Supabase injects.
#   - DATABASE_MIGRATE_URL = the DIRECT connection (port 5432). Used ONLY by
#                           `node scripts/migrate-deploy.mjs` at deploy time, because
#                           `prisma migrate deploy` needs advisory locks the pooler
#                           can't proxy. Leave unset to fall back to DATABASE_URL.
# The desktop app bundles its own embedded PostgreSQL, so end users never set
# this. For self-hosted/dev you can point at any Postgres instance.
DATABASE_URL="postgresql://vox:YOUR_PASSWORD@127.0.0.1:5432/vox_dev"

# Optional read replica (falls back to primary if unset). Use a connection
# pooler (e.g. pgbouncer / Supabase pooler) in production to avoid exhausting
# Postgres connections across PM2 workers.
DATABASE_REPLICA_URL=""

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# Allowed origins (comma-separated, no spaces):
# - Web frontend: http://localhost:3000, http://127.0.0.1:3000
# - Mobile app: null (native apps send Origin: null)
# - Production: https://yourdomain.com, app://localhost
CLIENT_ORIGIN="http://127.0.0.1:3000"
EXTRA_CORS_ORIGINS=""

# ── Redis (REQUIRED for multi-process / production scaling) ─────────────────
# The rate limiter, cache, presence, and Socket.io adapter use Redis so limits
# are enforced consistently across all PM2 workers. Without it, VOX falls back
# to in-memory mode (single process only).
# Free tier: Railway Redis add-on (auto-injects REDIS_URL) or
# https://upstash.com (free serverless Redis — paste its URL here).
# Local: redis://localhost:6379
REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL=60

# ── JWT (REQUIRED: generate real random values) ─────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_96_HEX_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_96_HEX_CHARS"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_TTL="14d"

# ── 2FA (REQUIRED for production: generate a real key) ──────────────────────
# Must be 64 hex chars (AES-256). ALWAYS generate a FRESH key — never reuse
# a committed/example value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_APP_NAME="VOX"
TWO_FACTOR_ENCRYPTION_KEY="REPLACE_WITH_RANDOM_64_HEX_CHARS"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Set to "dev" to log emails to console (development)
# Get a real key at https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY="dev"
RESEND_FROM_ADDRESS="VOX <noreply@vox.app>"

# ── Object Storage (uploads: avatars, attachments, sounds) ──────────────────
# When ALL of the below are set, uploads go to S3-compatible storage (AWS S3,
# Cloudflare R2, Backblaze B2) and are served via AWS_S3_PUBLIC_URL. This is
# required for multi-instance deployments (local disk is NOT shared).
# Free tier: Cloudflare R2 (10GB storage + 10M requests/mo, no egress fees).
# Leave blank to keep using local disk under /uploads (single-instance only).
AWS_S3_BUCKET=""
AWS_REGION="auto"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# For R2 set AWS_S3_ENDPOINT to your R2 endpoint, e.g.:
#   AWS_S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
AWS_S3_ENDPOINT=""
# Public base URL the browser uses to fetch files (R2 custom domain or CDN).
AWS_S3_PUBLIC_URL=""

# ── Voice / SFU (LiveKit) ───────────────────────────────────────────────
# When ALL three are set, voice channels with rtcMode = 'SFU' route media
# through a LiveKit SFU instead of peer-to-peer mesh. This scales to large
# voice channels (mesh is limited to ~6 participants). Mesh stays the default
# for channels without rtcMode = 'SFU' — leave these blank to keep mesh-only.
# Free tier: https://livekit.io (Cloud Starter) or self-host the Docker image.
# The backend exposes GET /api/voice/config + /api/voice/livekit-token.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ── Rate limiting (global HTTP limiter) ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
