# Copy to `.env` and fill in real values.

# Prisma / PostgreSQL. Create the DB first, then run: npx prisma migrate dev --name init
DATABASE_URL="postgresql://vox:YOUR_PASSWORD@localhost:5432/vox_dev?connection_limit=10"

# Connection pool size (must match DATABASE_URL query param above)
DATABASE_CONNECTION_LIMIT=10

# CORS / port
CLIENT_ORIGIN="http://127.0.0.1:3000"
# Optional: extra allowed browser origins (comma-separated), e.g. a tunnel URL.
EXTRA_CORS_ORIGINS=""
PORT=4000

# Redis (required for production — enables horizontal scaling, caching, and
# distributed rate limiting via Socket.io Redis adapter).
# Falls back to single-process mode if not set.
# Get a free Redis instance at https://upstash.com or run locally:
#   docker run -d -p 6379:6379 redis/redis-stack
REDIS_URL="redis://localhost:6379"
# Cache TTL in seconds (default: 60)
REDIS_CACHE_TTL=60

# JWT
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# 2FA
TWO_FACTOR_APP_NAME="VOX"
TWO_FACTOR_ENCRYPTION_KEY="64-hex-chars"

# Email (Resend) — for password reset & email verification.
# Set to "dev" (or leave unset) to log emails to console instead of sending.
# Get a real key at https://resend.com (free tier: 100 emails/day).
RESEND_API_KEY="dev"
RESEND_FROM_ADDRESS="VOX <noreply@vox.app>"
