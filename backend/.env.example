# VOX Backend Environment Configuration
# Copy to `.env` and fill in real values.

# ── Database ────────────────────────────────────────────────────────────────
# VOX uses SQLite by default (zero-setup). The Prisma schema provider is
# "sqlite" (backend/prisma/schema.prisma). This is the supported configuration.
DATABASE_URL="file:./vox.db"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# Allowed origins (comma-separated, no spaces):
# - Web frontend: http://localhost:3000, http://127.0.0.1:3000
# - Mobile app: null (native apps send Origin: null)
# - Production: https://yourdomain.com, app://localhost
CLIENT_ORIGIN="http://127.0.0.1:3000"
EXTRA_CORS_ORIGINS=""

# ── Redis (optional — only needed for multi-process scaling) ────────────────
# SQLite (the default DB) is single-node, so Redis is NOT required for a normal
# single-process deployment. Only set this if you run multiple backend
# processes and need Socket.io pub/sub across them.
# Local: redis://localhost:6379
REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL=60

# ── JWT (REQUIRED: generate real random values) ─────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_96_HEX_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_96_HEX_CHARS"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── 2FA (REQUIRED for production: generate a real key) ──────────────────────
# Must be 64 hex chars (AES-256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_APP_NAME="VOX"
TWO_FACTOR_ENCRYPTION_KEY="REPLACE_WITH_RANDOM_64_HEX_CHARS"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Set to "dev" to log emails to console (development)
# Get a real key at https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY="dev"
RESEND_FROM_ADDRESS="VOX <noreply@vox.app>"
