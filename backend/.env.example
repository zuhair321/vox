# Copy to `.env` and fill in real values.

# Prisma / MySQL. Create the DB first, then run: npx prisma migrate dev --name init
DATABASE_URL="mysql://vox:YOUR_PASSWORD@localhost:3306/vox_dev"

# CORS / port
CLIENT_ORIGIN="http://127.0.0.1:3000"
# Optional: extra allowed browser origins (comma-separated), e.g. a tunnel URL.
# EXTRA_CORS_ORIGINS="https://your-tunnel.example.com"
EXTRA_CORS_ORIGINS=""
PORT=4000

# JWT
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# 2FA
TWO_FACTOR_APP_NAME="VOX"
TWO_FACTOR_ENCRYPTION_KEY="64-hex-chars"
