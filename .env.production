# ═══════════════════════════════════════════════════════════════
# VOX — Production Environment (Oracle Cloud Free Tier)
# ═══════════════════════════════════════════════════════════════
# Copy this to .env and fill in real values before deploying.
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=vox_prod
POSTGRES_USER=vox
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── JWT (REQUIRED: generate real random values) ──────────────
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_96_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_A_DIFFERENT_RANDOM_96_HEX_CHARS
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d

# ── 2FA (REQUIRED: 64 hex chars = AES-256 key) ──────────────
TWO_FACTOR_APP_NAME=VOX
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_HEX_CHARS

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://YOUR_DOMAIN.com
EXTRA_CORS_ORIGINS=

# ── Redis ─────────────────────────────────────────────────────
# Handled by docker-compose (redis://redis:6379)
# No need to set REDIS_URL here — it's in docker-compose.yml

# ── Email (Resend) ────────────────────────────────────────────
# Free tier: https://resend.com (100 emails/day)
RESEND_API_KEY=dev
RESEND_FROM_ADDRESS="VOX <noreply@YOUR_DOMAIN.com>"

# ── File Storage ──────────────────────────────────────────────
# Local disk (single instance) — no S3 needed on Oracle Free Tier
# Leave blank to use local /uploads directory
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_URL=

# ── Voice / SFU (LiveKit) ────────────────────────────────────
# Optional: leave blank for mesh-only voice (free, P2P)
# Set all three for SFU mode (scales to large channels)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Domain (for deploy.sh) ───────────────────────────────────
DOMAIN=YOUR_DOMAIN.com
EMAIL=YOUR_EMAIL@DOMAIN.com

# ── Google OAuth ─────────────────────────────────────────────
# Get credentials at: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs: https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback
