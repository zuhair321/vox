# Vox Root Environment Configuration
# This file is read by the Electron builder/packager and the main process.
# The backend reads its own configuration from backend/.env.

# ============================================
# Database
# ============================================
# PostgreSQL connection string used by the packaged backend.
# Leave empty to let electron-main.js auto-configure the bundled Postgres.
DATABASE_URL=postgresql://vox:vox@127.0.0.1:5432/vox_dev
