# ═══════════════════════════════════════════════════════════════
# VOX Backend — Multi-stage Dockerfile
# ═══════════════════════════════════════════════════════════════
# Stage 1: Install dependencies + build Prisma client
# Stage 2: Production image with only runtime files

# ── Stage 1: Build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install build tools for native modules (bcrypt)
RUN apk add --no-cache python3 make g++

# Copy dependency manifests first (layer caching)
COPY backend/package.json backend/package-lock.json ./

# Install all deps (including dev for prisma generate)
RUN npm ci

# Copy Prisma schema and generate client
COPY backend/prisma ./prisma
RUN npx prisma generate

# ── Stage 2: Production ─────────────────────────────────────
FROM node:20-alpine AS production

WORKDIR /app

# Install runtime deps only
RUN apk add --no-cache tini curl

# Create non-root user
RUN addgroup -g 1001 -S vox && \
    adduser -S vox -u 1001 -G vox

# Copy node_modules from builder (production deps)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma

# Copy backend source
COPY backend/package.json ./
COPY backend/server.js ./
COPY backend/seed.mjs ./
COPY backend/src ./src
COPY backend/migrations ./migrations
COPY backend/scripts ./scripts

# Copy frontend dist (pre-built) — the SPA served by Express
COPY frontend/dist ./frontend/dist

# Create uploads directory
RUN mkdir -p /app/backend/uploads && \
    chown -R vox:vox /app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:4000/health || exit 1

# Switch to non-root user
USER vox

# Expose backend port
EXPOSE 4000

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Start with Prisma generate + migrations + server
CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy --schema=./prisma/schema.prisma && node src/server.js"]
