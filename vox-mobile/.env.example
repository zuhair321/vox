# VOX Mobile Environment Variables

# Backend API URL - Required for production builds
# For development: Leave empty or use your local IP (e.g., http://192.168.1.x:4000)
# For production: Set to your production API URL (e.g., https://api.vox.app)
EXPO_PUBLIC_API_URL=""

# Privacy Policy URL - Used in Settings screen and Play Store listing
EXPO_PUBLIC_PRIVACY_URL=""
