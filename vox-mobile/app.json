{
  "expo": {
    "name": "VOX",
    "slug": "vox-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "extra": {
      "eas": {
        "appVersionSource": "remote",
        "projectId": "d5e3ca1b-4ab6-4512-b645-1c7b50bd71b6"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vox.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VOX needs microphone access for voice chat"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vox.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "bundleInExpoClient": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "owner": "zuhair_xd"
  }
}
